{
  "name": "agent-skills",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "check": "oxfmt --check . && oxlint --no-error-on-unmatched-pattern . && tsc --noEmit && bun test",
    "wrap": "bun run scripts/wrap-markdown.ts",
    "wrap:check": "bun run scripts/wrap-markdown.ts --check",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
